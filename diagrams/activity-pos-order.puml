@startuml Activity_BanHangTheoBan_InHoaDon_CoffeeMango
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam activity {
    BackgroundColor #FFF2CC
    BorderColor #B25900
    BorderThickness 1.5
    ArrowColor #A61C1C
    FontSize 12
    FontColor #000000
}

skinparam activityDiamond {
    BackgroundColor #FFE599
    BorderColor #B25900
    BorderThickness 1.5
    ArrowColor #A61C1C
    FontSize 11
    FontColor #000000
}

skinparam swimlane {
    BorderColor #333333
    BorderThickness 1.5
    TitleBackgroundColor #F9CB9C
    TitleFontColor #000000
    TitleFontStyle bold
    FontSize 13
}

|Nhân viên phục vụ (Staff)|
start
:Mở giao diện Bán hàng POS;

|Hệ thống Coffee Mango|
:Tải sơ đồ bàn & trạng thái (Trống / Có khách);

|Nhân viên phục vụ (Staff)|
:Chọn bàn phục vụ trên sơ đồ;

repeat :Chọn các món đồ uống vào giỏ hàng;
:Điều chỉnh số lượng & Nhập giảm giá;
:Chọn phương thức thanh toán (Tiền mặt / QR);
:Bấm nút "Thanh toán & Xuất hóa đơn";

|Hệ thống Coffee Mango|
:Kiểm tra tính hợp lệ của giỏ hàng;
backward:Thông báo: "Giỏ hàng rỗng, vui lòng chọn món";
repeat while (Giỏ hàng hợp lệ?) is (Không) not (Có)

:Tính tổng tiền thanh toán & Lưu hóa đơn;
:Lưu chi tiết các món vào cơ sở dữ liệu;
:Cập nhật trạng thái bàn sang "Trống";
:Sinh mã QR & Kích hoạt lệnh in hóa đơn nhiệt;

|Nhân viên phục vụ (Staff)|
:Nhận bill in nhiệt & Bàn giao đồ uống cho khách;
stop

@enduml
