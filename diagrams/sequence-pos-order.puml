@startuml Sequence_TaoVaThanhToanHoaDon
autonumber
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam sequence {
    ArrowColor #8C532B
    ActorBorderColor #8C532B
    ActorBackgroundColor #FFF7ED
    ActorFontSize 12
    ActorFontStyle bold
    
    LifeLineBorderColor #8C532B
    LifeLineBackgroundColor #FFFDF8
    
    ParticipantBorderColor #8C532B
    ParticipantBackgroundColor #FFF7ED
    ParticipantFontSize 12
    ParticipantFontStyle bold
    
    GroupBorderColor #8C532B
    GroupBackgroundColor #FAFAFA
    GroupHeaderFontSize 12
    GroupFontSize 11
}

actor "Nhân viên\n(Staff)" as Staff
boundary "Giao diện POS\n(:POSView)" as View
control "OrderController\n(:Controller)" as Controller
control "OrderService\n(:Service)" as Service
control "TableService\n(:Service)" as TableService
entity "OrderRepository\n(:Repository)" as OrderRepo
entity "OrderDetailRepository\n(:Repository)" as DetailRepo
database "Cơ sở dữ liệu\n(MySQL)" as DB

' --- BƯỚC 1: CHỌN MÓN VÀ YÊU CẦU THANH TOÁN ---
Staff -> View : 1. Chọn bàn và thêm các món vào giỏ hàng
activate View
Staff -> View : 2. Điều chỉnh số lượng món & nhập giảm giá (nếu có)
Staff -> View : 3. Chọn phương thức thanh toán (Tiền mặt / QR Code)
Staff -> View : 4. Nhấn nút "Thanh toán & Xuất hóa đơn"

' --- BƯỚC 2: GỬI REQUEST VỀ BACKEND ---
View -> Controller : 5. Gửi POST /api/orders/checkout (OrderDTO)
activate Controller

Controller -> Service : 6. processOrderPayment(orderDTO)
activate Service

Service -> Service : 7. Kiểm tra tính hợp lệ của giỏ hàng\nvà tính lại tổng tiền thanh toán

alt #FFF5F5 [Giỏ hàng rỗng hoặc số lượng không hợp lệ]
    Service --> Controller : Ném ngoại lệ InvalidOrderException
    Controller --> View : Trả về lỗi 400 (Dữ liệu không hợp lệ)
    View --> Staff : Hiển thị cảnh báo: "Vui lòng chọn món trước khi thanh toán"

else #F0FDF4 [Giỏ hàng hợp lệ & Thanh toán thành công]
    ' --- BƯỚC 3: LƯU THÔNG TIN HÓA ĐƠN ---
    Service -> OrderRepo : 8. save(Order entity - Trạng thái: COMPLETED)
    activate OrderRepo
    OrderRepo -> DB : 9. INSERT INTO orders (total_price, payment_method, status...)
    activate DB
    DB --> OrderRepo : 10. Trả về Order đã lưu (kèm Generated ID)
    deactivate DB
    OrderRepo --> Service : 11. Trả về Order entity
    deactivate OrderRepo

    ' --- BƯỚC 4: LƯU TỪNG CHI TIẾT HÓA ĐƠN ---
    loop Từng sản phẩm trong giỏ hàng
        Service -> DetailRepo : 12. save(OrderDetail entity)
        activate DetailRepo
        DetailRepo -> DB : 13. INSERT INTO order_details (order_id, product_id, quantity, price...)
        activate DB
        DB --> DetailRepo : 14. Xác nhận lưu chi tiết
        deactivate DB
        DetailRepo --> Service : 15. Hoàn tất lưu món
        deactivate DetailRepo
    end

    ' --- BƯỚC 5: CẬP NHẬT TRẠNG THÁI SƠ ĐỒ BÀN ---
    Service -> TableService : 16. updateTableStatus(tableId, "AVAILABLE")
    activate TableService
    TableService -> DB : 17. UPDATE dining_tables SET status = 'AVAILABLE' WHERE id = ?
    activate DB
    DB --> TableService : 18. Xác nhận cập nhật bàn
    deactivate DB
    TableService --> Service : 19. Hoàn tất giải phóng bàn
    deactivate TableService

    ' --- BƯỚC 6: PHẢN HỒI KẾT QUẢ VÀ IN HÓA ĐƠN ---
    Service --> Controller : 20. Trả về OrderResponseDTO (thành công)
    deactivate Service

    Controller --> View : 21. Phản hồi HTTP 200 OK (Chi tiết hóa đơn & mã Bill)
    deactivate Controller

    View -> View : 22. Kích hoạt lệnh in hóa đơn nhiệt (kèm mã QR thanh toán)
    View --> Staff : 23. Hiển thị thông báo thành công & Mở giao diện in Bill
    deactivate View
end
@enduml
